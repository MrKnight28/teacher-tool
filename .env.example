# Copy to .env (git-ignored). setup.ps1 / setup.sh writes this for you.
# Every value here is empty or an obvious placeholder. Never commit a filled-in .env.

# openrouter (API key) or claude-cli (Claude Pro/Max via `claude setup-token`)
LLM_PROVIDER=openrouter

# Paste your own keys. Leave unused ones blank.
OPENROUTER_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Claude model override per task (for example sonnet or haiku)
# CLAUDE_MODEL_LESSON=
# CLAUDE_MODEL_CHAT=
# CLAUDE_MODEL_MARK=

# OpenRouter model ids (setup can fill these in)
MODEL_PLAN=
MODEL_TEACH=
MODEL_MARK=
MODEL_CHEAP=
MODEL_VISION=

# Optional Gemini speech overrides
GEMINI_TTS_MODEL=
GEMINI_VOICE=

TUTOR_DATA_DIR=./data
TUTOR_PACK=security-plus-sy0-701
TUTOR_PACKS_DIR=./packs
TUTOR_PORT=8080

# Required. Any random string of at least 16 characters. The server refuses a shorter one.
TUTOR_TOKEN=

# Backup reminder channel. The ntfy topic is a secret: use a long random path.
NTFY_URL=
NTFY_TOKEN=
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# WhatsApp via OpenClaw (optional). Number in international format, for example +447700900000.
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.8
OPENCLAW_FALLBACK_MODELS=
WHATSAPP_TO=
TUTOR_WA_TOKEN=

# Tailscale (optional). Create an auth key in the Tailscale admin console; it starts with tskey-auth-.
TS_AUTHKEY=
TS_HOSTNAME=teacher-tool

# Folders on your own machine. These examples are not a real profile.
OBSIDIAN_TUTOR_DIR=C:\Users\you\Documents\TutorNotes
BACKUP_DIR=D:\Backups\teacher-tool

TZ=Europe/London
